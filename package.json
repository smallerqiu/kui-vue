{
  "name": "kui-vue",
  "private": false,
  "version": "6.2.2",
  "type": "module",
  "description": "A lightweight desktop UI component library suitable for Vue.js 3.",
  "main": "lib/index.cjs",
  "module": "es/index.js",
  "unpkg": "dist/index.js",
  "jsdelivr": "dist/index.js",
  "style": "style/index.css",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./es/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./global": {
      "types": "./types/global.d.ts"
    },
    "./locale/*": {
      "import": {
        "types": "./types/locale/*.d.ts",
        "default": "./es/locale/*.js"
      },
      "require": {
        "types": "./types/locale/*.d.cts",
        "default": "./lib/locale/*.cjs"
      }
    },
    "./style/*": "./style/*",
    "./metadata": "./ai/kui-components.json",
    "./metadata/schema": "./ai/kui-components.schema.json",
    "./skill": "./ai/skills/kui-vue/SKILL.md",
    "./skill/*": "./ai/skills/kui-vue/*"
  },
  "bin": {
    "kui-vue-ai": "./ai/cli.mjs",
    "kui-vue-mcp": "./ai/mcp.mjs"
  },
  "files": [
    "AI.md",
    "AI.en-US.md",
    "dist",
    "vetur",
    "lib",
    "style",
    "es",
    "types",
    "ai"
  ],
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "check:theme": "node --experimental-strip-types --max-old-space-size=512 scripts/check-theme.ts",
    "start": "pnpm dev",
    "dev": "vite --config vite.config.docs.ts",
    "build": "node --experimental-strip-types scripts/build.ts",
    "build:es": "node --experimental-strip-types scripts/build.ts es",
    "build:lib": "node --experimental-strip-types scripts/build.ts lib",
    "build:umd": "node --experimental-strip-types scripts/build.ts umd",
    "build:css": "node --experimental-strip-types scripts/build.ts css",
    "build:types:compat": "node --experimental-strip-types scripts/create-cjs-types.ts",
    "build:docs": "pnpm generate:ai && pnpm check:api-docs && node --experimental-strip-types scripts/build.ts docs",
    "preview": "vite preview --outDir docs",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit --pretty false && pnpm typecheck:node",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "typecheck:exports": "tsc -p tsconfig.type-exports.json --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "format": "prettier --write .",
    "format:md": "prettier --write ./components/*/index*.md",
    "generate:ai": "node --max-old-space-size=2048 --experimental-strip-types scripts/generate-ai-assets.ts",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "package:check": "publint --strict && node --experimental-strip-types scripts/check-package-exports.ts",
    "generate:api-docs": "node --max-old-space-size=2048 --experimental-strip-types scripts/generate-ai-assets.ts --docs",
    "check:api-types": "node --max-old-space-size=2048 --experimental-strip-types scripts/generate-ai-assets.ts --check-docs",
    "check:api-docs": "node --max-old-space-size=2048 --experimental-strip-types scripts/check-api-docs.ts && pnpm check:api-types",
    "check:ai-assets": "node --max-old-space-size=2048 --experimental-strip-types scripts/generate-ai-assets.ts --check && pnpm audit:ai-metadata",
    "audit:ai-metadata": "node --experimental-strip-types scripts/audit-ai-metadata.ts",
    "check:ai-evals": "node ai/evals/run.mjs --reference",
    "verify": "pnpm lint && pnpm typecheck && pnpm typecheck:exports && pnpm check:api-docs && pnpm check:ai-assets && pnpm check:ai-evals && pnpm check:ai-templates && pnpm test && pnpm test:visual && pnpm build && pnpm build:docs && pnpm package:check",
    "build:local": "node --experimental-strip-types scripts/build.ts local",
    "build:types": "node --experimental-strip-types scripts/build.ts types",
    "check:ai-templates": "node --max-old-space-size=2048 node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.ai-templates.json --noEmit && node --max-old-space-size=2048 node_modules/vitest/vitest.mjs run tests/ai-templates.test.ts --maxWorkers=1",
    "eval:ai": "node ai/evals/run.mjs"
  },
  "author": {
    "name": "Qiu",
    "email": "smallerqiu@gmail.com"
  },
  "homepage": "https://k-ui.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smallerqiu/kui-vue.git"
  },
  "bugs": {
    "url": "https://github.com/smallerqiu/kui-vue/issues",
    "email": "smallerqiu@gmail.com"
  },
  "keywords": [
    "vue",
    "vue3",
    "kui",
    "kui-vue",
    "vue-components",
    "component-library",
    "ui",
    "ui-library",
    "ui-components",
    "ui-kit",
    "design-system",
    "typescript",
    "admin-ui"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "dependencies": {
    "@vue/compiler-dom": "3.5.42",
    "big.js": "^7.0.1",
    "color": "^5.0.3",
    "dayjs": "^1.11.23",
    "kui-icons": "^5.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stackblitz/sdk": "^1.11.1",
    "@types/babel__core": "^7.20.5",
    "@types/big.js": "^7.0.0",
    "@types/hash-sum": "^1.0.2",
    "@types/less": "^3.0.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.0",
    "codejar": "^4.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.12.0",
    "hash-sum": "^2.0.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.1",
    "less": "^4.9.1",
    "lz-string": "^1.5.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "sucrase": "^3.35.1",
    "terser": "^5.51.2",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "vetur": {
    "tags": "vetur/tags.json",
    "attributes": "vetur/attributes.json"
  },
  "web-types": "./vetur/web-types.json"
}
