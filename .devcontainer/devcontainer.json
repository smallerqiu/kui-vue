{
  "name": "KUI Vue",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "corepack enable && pnpm install",
  "postStartCommand": "pnpm dev --host 0.0.0.0 > /tmp/kui-vue-docs.log 2>&1 &",
  "forwardPorts": [7005],
  "portsAttributes": {
    "7005": {
      "label": "KUI Vue Docs",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Vue.volar"]
    }
  }
}
